curl -X POST http://localhost:5000/api/github/graphql/12345678 \
  -H "Content-Type: application/json" \
  -d '{
    "query": "query ($owner: String!, $repo: String!) { repository(owner: $owner, name: $repo) { name stargazerCount openIssues: issues(states: OPEN) { totalCount } } }",
    "variables": {
      "owner": "dotnet",
      "repo": "aspnetcore"
    }
  }'