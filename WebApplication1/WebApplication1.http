@WebApplication1_HostAddress = https://localhost:58090
@installationId = {{Installid}}

### Test GitHub GraphQL Proxy
POST {{WebApplication1_HostAddress}}/api/github/graphql/{{installationId}}
Content-Type: application/json

{
  "query": "query ($owner: String!, $repo: String!) { repository(owner: $owner, name: $repo) { name stargazerCount openIssues: issues(states: OPEN) { totalCount } } }",
  "variables": {
    "owner": "owner",
    "repo": "repo"
  }
}
